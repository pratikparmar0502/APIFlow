# ─────────────────────────────────────────────
#  APIFlow — Environment Variable Reference
#  Copy this file to .env and fill in values.
#  NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── Backend ──────────────────────────────────
# MongoDB connection URI (required)
MONGODB_URI=mongodb://localhost:27017/apiflow

# Port for the Express backend (default: 3001)
PORT=3001

# Node environment
NODE_ENV=development

# ── Security ─────────────────────────────────
# Maximum outbound request timeout in milliseconds (default: 30000)
MAX_REQUEST_TIMEOUT_MS=30000

# Maximum response body size in bytes (default: 5242880 = 5 MB)
MAX_RESPONSE_SIZE_BYTES=5242880

# Maximum concurrent workflow executions (default: 5)
MAX_CONCURRENT_EXECUTIONS=5

# Maximum number of nodes allowed per workflow (default: 50)
MAX_WORKFLOW_NODES=50

# ── Frontend (Vite) ───────────────────────────
# Backend API base URL used by the Vite dev proxy (default: http://localhost:3001)
VITE_API_BASE_URL=http://localhost:3001
